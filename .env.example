# Copy this file to `.env` to change anything. The app runs fine with NO .env at all.

# --- Database ---------------------------------------------------------------
# Default (leave unset): SQLite file at data/delhi_aqi.db. Zero setup.
# For PostgreSQL (Docker Compose sets this for you; Render/Neon give you a URL):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/delhi_aqi

# --- Optional ground-station data (OpenAQ v3) --------------------------------
# Free key from https://explore.openaq.org . Leave empty to skip real stations;
# the map then shows the model cells and neighbourhoods only.
OPENAQ_API_KEY=

# --- Data -------------------------------------------------------------------
# Open-Meteo's global air-quality history starts on this date. Earlier hours are empty.
HISTORY_START=2022-08-04

# --- Which pollutants can set the headline AQI -------------------------------
# pm2_5 (default) | pm (PM2.5 + PM10) | all (official six-pollutant NAQI).
# The free CAMS model data has ozone and dust (PM10) artefacts, see README "Data caveats".
AQI_BASIS=pm2_5

# --- Scheduler (inside the API process; Docker Compose uses a separate worker) ----
ENABLE_SCHEDULER=true
REFRESH_MINUTES=60
RETRAIN_DAYS=7

# --- Web server -------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Comma-separated origins allowed to call the API from a browser (only needed when
# the frontend runs on another origin, e.g. `npm run dev` on :3000).
CORS_ORIGINS=http://localhost:3000
